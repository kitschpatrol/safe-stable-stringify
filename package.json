{
	"name": "@kitschpatrol/safe-stable-stringify",
	"version": "2.5.0-fork.2",
	"description": "Fork of safe-stable-stringify with an ESM fix.",
	"keywords": [
		"serialize",
		"stable",
		"stringify",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/safe-stable-stringify",
	"bugs": "https://github.com/kitschpatrol/safe-stable-stringify/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/safe-stable-stringify.git"
	},
	"license": "MIT",
	"author": {
		"name": "Ruben Bridgewater",
		"email": "ruben@bridgewater.de"
	},
	"contributors": [
		{
			"name": "Eric Mika",
			"email": "eric@ericmika.com",
			"url": "https://ericmika.com"
		}
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"bench": "pnpm build && vitest bench --run",
		"bench:baseline": "pnpm build && BENCH_BASELINE=write vitest bench --run",
		"bench:compare": "pnpm build && BENCH_BASELINE=compare vitest bench --run --reporter=default --reporter=json --outputFile=test/benchmarks/compare.json",
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --preid fork --commit 'Release: %s' && pnpm build && pnpm publish --tag latest --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.13.1",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"fast-json-stable-stringify": "^2.1.0",
		"fast-safe-stringify": "^2.1.1",
		"fast-stable-stringify": "^1.0.0",
		"faster-stable-stringify": "^1.0.0",
		"fastest-stable-stringify": "^2.0.2",
		"json-stable-stringify": "^1.3.0",
		"json-stringify-deterministic": "^1.0.16",
		"publint": "^0.3.25",
		"safe-stable-stringify": "^2.5.0",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^20.19.0 || ^22.0.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
